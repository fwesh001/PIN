# ─────────────────────────────────────────────────────────────
# NJPST — Environment Variable Reference
#
# Copy to `.env` for local/dev. NEVER commit the real `.env` (gitignored).
# For Render, set these in the dashboard (OJS vars on the OJS service,
# the NEXT_* / OJS_* frontend vars on the Next.js service).
# ─────────────────────────────────────────────────────────────

# ── OJS Backend (deployed separately, e.g. on Render) ──────────
# Server-side REST API base URL used by Next.js Server Components.
OJS_API_URL="https://YOUR-OJS-SUBDOMAIN/api/v1"
# API key generated in the OJS user profile (Server Components only).
OJS_API_KEY="your-ojs-api-key-here"
# Public journal base URL (builds galley/file download links).
OJS_BASE_URL="https://YOUR-OJS-SUBDOMAIN"

# ── Next.js public var (client-side links to OJS portal) ──────
NEXT_PUBLIC_OJS_URL="https://YOUR-OJS-SUBDOMAIN"

# ── OJS container env (only needed when running the OJS Docker
#    image locally / on Render — NOT used by Next.js) ──────────
# OJS_BASE_URL        # same as above, used inside the OJS container
# OJS_DB_HOST         # MySQL host (e.g. Aiven MySQL host)
# OJS_DB_PORT         # MySQL port (e.g. 24181)
# OJS_DB_USER         # MySQL user (e.g. avnadmin)
# OJS_DB_NAME         # MySQL database name (e.g. defaultdb)
# OJS_DB_PASSWORD     # MySQL password  ⚠️ secret
# OJS_API_SECRET      # random string enabling REST API tokens ⚠️ secret
# OJS_SMTP_*          # optional SMTP for transactional email
